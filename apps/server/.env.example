# 运行环境 development | test | production
NODE_ENV=development
# 监听地址与端口
HOST=0.0.0.0
PORT=3000
# SQLite 数据库文件路径（相对 server 目录）
DATABASE_PATH=data/qujt.db
# JWT 签名密钥：生产环境必填，至少 16 字符；开发环境缺省时自动生成临时密钥
JWT_SECRET=please-change-me-32-chars-minimum!!!
# access token 有效期（@fastify/jwt 时间格式）
JWT_EXPIRES_IN=2h
# refresh token 有效期（天）
REFRESH_EXPIRES_DAYS=30
# 首次启动（无管理员账号时）自动创建的管理员
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
ADMIN_EMAIL=admin@example.com
